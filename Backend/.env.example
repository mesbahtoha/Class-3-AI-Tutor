# =============================================================================
# Class 3 AI Tutor — Backend environment template
# Copy to .env and fill with REAL values (never commit .env with secrets).
# cp .env.example .env
# DBMS: NeonDB (PostgreSQL + pgvector). See README for Neon setup steps.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1
WEB_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Database (NeonDB) ---
# Neon pooled connection (use -pooler host for serverless/app runtime):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon direct connection (use for Prisma migrations):
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# Firebase Admin: PREFER workload credentials in production (GOOGLE_APPLICATION_CREDENTIALS).
# For local dev you may use one of the options below (never commit real values).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A (recommended local): path to downloaded service-account JSON (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option B (single env var): base64 of the service-account JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Guest sessions (server-signed JWT). Generate: openssl rand -base64 48
GUEST_JWT_SECRET=replace-me-generate-strong-random-secret
GUEST_SESSION_TTL_HOURS=24

# --- Storage (S3-compatible, e.g. Cloudflare R2; local adapter for dev) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_REGION=auto
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

# --- Background jobs ---
# If empty, backend uses an in-process fallback queue (single instance dev).
# For production set to Upstash/Redis Cloud / self-hosted Redis.
REDIS_URL=

# --- LLM provider (text generation; model IDs are config, not code) ---
AI_PROVIDER=mock
AI_MODEL=mock-tutor-v1
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Class3-AI-Tutor-Dev
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_BUDGET_USD=1

# --- Embeddings (SEPARATE from LLM provider) ---
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-1536-v1
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# --- OCR / speech adapters (enable only after provider verified) ---
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_ENDPOINT=
STT_PROVIDER=mock
STT_API_KEY=
STT_ENDPOINT=
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_ENDPOINT=

# --- Limits (tune after testing; see backend_readme §14.3) ---
GUEST_CHAT_LIMIT_PER_DAY=10
AUTH_CHAT_LIMIT_PER_DAY=100
MAX_UPLOAD_SIZE_MB=10
MAX_BOOK_PDF_PAGES=600
MAX_IMAGE_COUNT_PER_DAY=20
MAX_AUDIO_SECONDS=120
TEMP_UPLOAD_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Super-admin bootstrap (server-side only, never expose as API) ---
BOOTSTRAP_FIREBASE_UID=
BOOTSTRAP_ADMIN_EMAIL=
