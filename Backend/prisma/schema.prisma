// Prisma schema — Class 3 AI Tutor (NeonDB: PostgreSQL + pgvector)
// - Runtime: DATABASE_URL (Neon pooled -pooler host)
// - Migrations: DIRECT_URL (Neon direct host)
// - pgvector + full-text search are enabled in the base migration SQL.
// - document_chunks.embedding uses pgvector; manage via raw SQL (Prisma
//   has no native vector type) — see prisma/migrations/0001_init.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUARDIAN
  TEACHER
  CONTENT_EDITOR
  SUPPORT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  REVIEW_REQUIRED
  READY_TO_PUBLISH
  PUBLISHED
  FAILED
  NEEDS_RETRY
  UNPUBLISHED
  ARCHIVED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum UploadKind {
  BOOK_SOURCE
  LEARNER_IMAGE
  LEARNER_AUDIO
  OTHER
}

enum UploadStatus {
  PENDING
  READY
  PROCESSING
  FAILED
  EXPIRED
  DELETED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AnswerStatus {
  ANSWERED
  INSUFFICIENT_BOOK_CONTEXT
  CLARIFICATION_NEEDED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model User {
  id          String     @id @default(cuid())
  firebaseUid String     @unique
  email       String?
  role        Role       @default(GUARDIAN)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  childProfiles ChildProfile[]
  conversations Conversation[]
  uploads       Upload[]
  quizAttempts  QuizAttempt[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  usageLogs     UsageLog[]

  @@index([role])
  @@map("users")
}

model ChildProfile {
  id                String    @id @default(cuid())
  guardianUserId    String
  guardian          User      @relation(fields: [guardianUserId], references: [id], onDelete: Cascade)
  nickname          String
  grade             String    @default("Class 3")
  curriculumId      String?
  curriculum        Curriculum? @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  preferredLanguage String    @default("auto")
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversations    Conversation[]
  learningSessions LearningSession[]
  progressEntries  LearningProgress[]

  @@index([guardianUserId])
  @@map("child_profiles")
}

model Curriculum {
  id        String   @id @default(cuid())
  name      String
  track     String   @default("NCTB")
  locale    String   @default("bn-BD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects      Subject[]
  books         Book[]
  childProfiles ChildProfile[]

  @@unique([name, track])
  @@map("curricula")
}

model Subject {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  name         String
  code         String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  books Book[]

  @@unique([curriculumId, name])
  @@map("subjects")
}

model Book {
  id                String           @id @default(cuid())
  title             String
  grade             String           @default("Class 3")
  curriculumId      String?
  curriculum        Curriculum?      @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  curriculumName    String           @default("NCTB")
  subjectId         String?
  subject           Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectName       String           @default("")
  language          String           @default("bn")
  editionYear       String?
  editionLabel      String?
  publisher         String?
  sourceUrl         String?
  rightsStatus      String?
  storageKey        String?
  mimeType          String?
  fileSize          BigInt?
  checksum          String?
  pageCount         Int?
  processingStatus  ProcessingStatus @default(UPLOADED)
  publicationStatus PublicationStatus @default(DRAFT)
  uploadedBy        String?
  reviewedBy        String?
  publishedBy       String?
  extractionNotes   String?
  isDeleted         Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  chapters       Chapter[]
  pages          BookPage[]
  chunks         DocumentChunk[]
  ingestionJobs  IngestionJob[]
  messageSources MessageSource[]

  @@index([publicationStatus, processingStatus])
  @@index([curriculumName, grade, subjectName])
  @@map("books")
}

model Chapter {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number      String?
  title       String
  order       Int      @default(0)
  pageStart   Int?
  pageEnd     Int?
  createdAt   DateTime @default(now())

  chunks DocumentChunk[]

  @@index([bookId, order])
  @@map("chapters")
}

model BookPage {
  id                String   @id @default(cuid())
  bookId            String
  book              Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber        Int
  printedLabel      String?
  text              String
  extractionQuality String   @default("ok")
  createdAt         DateTime @default(now())

  @@unique([bookId, pageNumber])
  @@index([bookId])
  @@map("book_pages")
}

model DocumentChunk {
  id              String   @id @default(cuid())
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId       String?
  chapter         Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  pageStart       Int?
  pageEnd         Int?
  content         String
  contentHash     String
  embeddingModel  String   @default("hash-1536-v1")
  embeddingVersion String  @default("v1")
  // pgvector column managed in raw SQL migration (vector(EMBEDDING_DIMENSION)).
  // Prisma maps it as Unsupported; all similarity queries use $queryRaw.
  embedding       Unsupported("vector(1536)")?
  searchTsv       Unsupported("tsvector")?
  tokenCount      Int?
  createdAt       DateTime @default(now())

  messageSources MessageSource[]

  @@index([bookId])
  @@index([contentHash])
  @@map("document_chunks")
}

model IngestionJob {
  id          String    @id @default(cuid())
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status      JobStatus @default(QUEUED)
  progress    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  errorCode   String?
  errorDetail String?
  jobLog      String?   @db.Text
  idempotencyKey String? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([bookId])
  @@map("ingestion_jobs")
}

model Upload {
  id         String       @id @default(cuid())
  ownerId    String?
  owner      User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  storageKey String
  mediaKind  UploadKind
  mimeType   String?
  fileSize   BigInt?
  status     UploadStatus @default(PENDING)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  @@index([ownerId])
  @@index([status])
  @@map("uploads")
}

model Conversation {
  id            String             @id @default(cuid())
  ownerId       String?
  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  guestSessionId String?
  childProfileId String?
  childProfile  ChildProfile?      @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  title         String?
  status        ConversationStatus @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  messages Message[]

  @@index([ownerId, createdAt])
  @@index([guestSessionId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             MessageRole
  content          String       @db.Text
  detectedLanguage String?
  answerStatus     AnswerStatus?
  provider         String?
  model            String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  safetyFlag       String?
  createdAt        DateTime     @default(now())

  sources MessageSource[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageSource {
  id          String        @id @default(cuid())
  messageId   String
  message     Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunkId     String
  chunk       DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookTitle   String
  chapterTitle String?
  pageStart   Int?
  pageEnd     Int?
  score       Float?

  @@index([messageId])
  @@map("message_sources")
}

model Lesson {
  id          String   @id @default(cuid())
  topic       String
  title       String
  content     Json
  sources     Json?
  status      String   @default("READY")
  provider    String?
  model       String?
  ownerId     String?
  createdAt   DateTime @default(now())

  slides LessonSlide[]

  @@map("lessons")
}

model LessonSlide {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  type     String
  data     Json

  @@index([lessonId, order])
  @@map("lesson_slides")
}

model Quiz {
  id        String   @id @default(cuid())
  topic     String?
  lessonId  String?
  title     String
  questions Json
  answerKey Json
  status    String   @default("READY")
  provider  String?
  model     String?
  createdAt DateTime @default(now())

  attempts QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  answers   Json
  score     Float?
  feedback  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([quizId])
  @@index([ownerId])
  @@map("quiz_attempts")
}

model LearningSession {
  id             String    @id @default(cuid())
  childProfileId String?
  childProfile   ChildProfile? @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  ownerId        String?
  lessonId       String?
  topic          String?
  status         String    @default("STARTED")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("learning_sessions")
}

model LearningProgress {
  id             String       @id @default(cuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  topicId        String
  attempts       Int          @default(0)
  bestScore      Float?
  lastScore      Float?
  updatedAt      DateTime     @updatedAt

  @@unique([childProfileId, topicId])
  @@map("learning_progress")
}

model Feedback {
  id        String   @id @default(cuid())
  messageId String?
  rating    Int?
  comment   String?  @db.Text
  reportType String?
  status    String   @default("NEW")
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([status])
  @@map("feedback")
}

model ProviderConfig {
  id        String   @id @default(cuid())
  provider  String
  model     String
  capabilities Json?
  limits    Json?
  isActive  Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([provider, model])
  @@map("provider_configs")
}

model UsageLog {
  id          String   @id @default(cuid())
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  provider    String
  model       String
  operation   String
  promptTokens Int?
  completionTokens Int?
  latencyMs   Int?
  status      String   @default("OK")
  estCostUsd  Float?
  requestId   String?
  createdAt   DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([provider, createdAt])
  @@map("usage_logs")
}

model SafetyEvent {
  id        String   @id @default(cuid())
  eventType String
  action    String
  requestId String?
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@map("safety_events")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  requestId String?
  summary   Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model GuestSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  requestCount Int    @default(0)

  @@index([expiresAt])
  @@map("guest_sessions")
}
